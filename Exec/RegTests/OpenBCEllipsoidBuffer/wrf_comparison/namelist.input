 &time_control
 run_days                            = 0,
 run_hours                           = 0,
 run_minutes                         = 6,
 run_seconds                         = 0,
 start_year                          = 2006,
 start_month                         = 01,
 start_day                           = 01,
 start_hour                          = 09,
 start_minute                        = 00,
 start_second                        = 00,
 end_year                            = 2006,
 end_month                           = 01,
 end_day                             = 01,
 end_hour                            = 09,
 end_minute                          = 45,
 end_second                          = 00,
 history_interval_s                  = 60,
 frames_per_outfile                  = 1,
 restart                             = .false.,
 io_form_history                     = 2
 io_form_restart                     = 2
 io_form_input                       = 2
 io_form_boundary                    = 2
 /

 &domains
 time_step                           = 0,
 time_step_fract_num                 = 1,
 time_step_fract_den                 = 4,
 max_dom                             = 1,
 s_we                                = 1,
 e_we                                = 53,
 s_sn                                = 1,
 e_sn                                = 53,
 s_vert                              = 1,
 e_vert                              = 51,
 dx                                  = 100,
 dy                                  = 100,
 ztop                                = 2000,
 grid_id                             = 1,
 parent_id                           = 0,
 i_parent_start                      = 0,
 j_parent_start                      = 0,
 parent_grid_ratio                   = 1,
 parent_time_step_ratio              = 1,
 feedback                            = 1,
 smooth_option                       = 0
 sr_x                                = 4,
 sr_y                                = 4,
 /

 &physics
 mp_physics                          = 0,
 ra_lw_physics                       = 0,
 ra_sw_physics                       = 0,
 radt                                = 30,
 sf_sfclay_physics                   = 0,
 sf_surface_physics                  = 0,
 bl_pbl_physics                      = 0,
 bldt                                = 0,
 cu_physics                          = 0,
 cudt                                = 0,
 isfflx                              = 0,
 ifsnow                              = 0,
 icloud                              = 0,
 mp_zero_out                         = 0,
 /

 &fdda
 /

 &dynamics
 hybrid_opt                          = 0,
 rk_ord                              = 3,
 diff_opt                            = 2,
 km_opt                              = 2,
 damp_opt                            = 2,
 zdamp                               = 800.,
 dampcoef                            = 0.2,
 khdif                               = 0.05,
 kvdif                               = 0.05,
 smdiv                               = 0.1,
 emdiv                               = 0.01,
 epssm                               = 0.1,
 mix_full_fields                     = .true.,
 non_hydrostatic                     = .true.,
 h_mom_adv_order                     = 5,
 v_mom_adv_order                     = 3,
 h_sca_adv_order                     = 5,
 v_sca_adv_order                     = 3,
 time_step_sound                     = 20,
 moist_adv_opt                       = 1,
 scalar_adv_opt                      = 1,
 tracer_opt                          = 3,
 /

 &bdy_control
 periodic_x                          = .false.,
 symmetric_xs                        = .false.,
 symmetric_xe                        = .false.,
 open_xs                             = .true.,
 open_xe                             = .true.,
 periodic_y                          = .false.,
 symmetric_ys                        = .false.,
 symmetric_ye                        = .false.,
 open_ys                             = .true.,
 open_ye                             = .true.,
 /

 &grib2
 /

 &namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
 /

 &fire ! be sure to set sr_x,sr_y in domains-namelist (to set refinement in x,y)
 ifire              = 2,               ! integer, = 0: no fire, 2=turn on fire model
 fire_fuel_read     = 0,               ! integer, -1: from WPS, 0= use fire_fuel_cat, 1= by altitude
 fire_fuel_cat      = 1,               ! FM1 short grass, matches erf.fire.fuel_model_id = 1
!
! Finite ignition LINE (not a point): perpendicular to the wind, centered
! 1000 m upwind of the same reference point (2500,2500) used by the hill
! cases, along the wind's own bearing. Numerically identical endpoints to
! case_hill_line_advective_34deg's -- the ridge crest runs through x=2500
! regardless of y, so "upwind of (2500,2500)" still means "upwind of the
! ridge". Matches ERF's FireRidgeLineAdvective34deg/line_ignition.csv.
 fire_num_ignitions = 1,
! ros1 is the ignition disk's own growth rate (radius/ros1 seconds to reach
! full radius), not the physical spread rate -- unrelated to fire_ignition_ros
! naming, this must be fast enough to fill fire_ignition_radius1 within the
! start/end_time1 window. ERF's erf.fire.ignition_r lights the full disk
! instantly at t=0, so ros1=100 (radius/ros1=0.6s) matches that here.
 fire_ignition_ros1 =   100.,
 fire_ignition_start_x1 = 967.10,
 fire_ignition_start_y1 = 1121.52,
 fire_ignition_end_x1   = 1796.14,
 fire_ignition_end_y1   = 562.33,
 fire_ignition_radius1  =   25.,       ! matches ERF's polyline_width=25 (one fire cell)
 fire_ignition_start_time1 = 0.,
 fire_ignition_end_time1   = 1.,
 fire_wind_height = 6.1,               ! matches erf.fire.wind_ref_ht; moot since the sounding wind is uniform with height
!
! erf.fire.directional_wind_coupling = "advective" matches fire_advection = 1
! (see case_erf_advective_match/namelist.input for the full derivation).
 fire_advection = 1,
!
! verbosity
 fire_print_msg     = 1,
 fire_print_file    = 0,
!
 fire_const_time = -1.,
 fire_const_grnhfx = -1,
 fire_const_grnqfx = -1,
 fire_test_steps=0,
!
! Ridge terrain read from file instead of fire_mountain_type's built-in
! formula (which only supports axis-aligned NS/EW ridges): input_ht /
! input_zsf contain a ridge crest ROTATED to be perpendicular to this
! case's 34deg wind bearing (same head-on incidence as the 90deg case's
! NS ridge vs due-east wind), height 300 m, same width in the projected
! coordinate as the axis-aligned ridge's x-footprint. Generated by
! gen_wrf_rotated_ridge.py. Dimensions (53x53 atm, 212x212 fire) confirmed
! via read_array_2d_real's own error message from a placeholder-file probe.
 fire_mountain_type=0,
 fire_read_atm_ht=.true.,
 fire_read_fire_ht=.true.,
 fire_mountain_height=300.,
 fire_mountain_start_x=1500.,
 fire_mountain_start_y=1500.,
 fire_mountain_end_x=3500.,
 fire_mountain_end_y=3500.,
 fire_topo_from_atm=1,
 delt_perturbation = 0.0,
!
 stretch_grd = .true.,
 stretch_hyp = .true.,
 z_grd_scale = 2.35
!
 fire_fuel_left_irl=2,
 fire_fuel_left_jrl=2,
 fire_atm_feedback=0.0,         ! one-way coupling (OFF) -- matches ERF's
                                 ! coupling_type="lagged" + fire_atm_feedback=0.0,
                                 ! isolating level-set/Rothermel spread physics
                                 ! from fire-atmosphere feedback differences.
 fire_grows_only=1,
! fire_viscosity is actually the far-field value and fire_viscosity_bg the
! near-front value (module_fr_fire_core.F's blend formula), despite the
! "_bg" name -- set to match ERF's erf.fire.levelset.eps_visc/eps_visc_front
! defaults (0.4 far-field, 0.1 near-front). The previous fire_viscosity=0.1
! with fire_viscosity_bg left at its 0.4 default had these backwards
! (higher viscosity right at the front than far away from it).
 fire_viscosity=0.4,
 fire_viscosity_bg=0.1,
 fire_upwinding=9,
 fire_fuel_left_method=1,
 fire_lfn_ext_up=1.0,
! Reinitialization off for this comparison run (matches ERF's
! levelset.reinit_every below being pushed effectively to "never").
! fire_lsm_reinit_iter/fire_upwinding_reinit/fire_lsm_band_ngp are unused
! while fire_lsm_reinit=.false. but left here for reference.
 fire_lsm_reinit = .false.,
 fire_lsm_reinit_iter = 1,
 fire_upwinding_reinit = 4,
 fire_lsm_band_ngp = 4,
/
