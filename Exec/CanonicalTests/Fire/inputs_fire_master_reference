# Document canonical regression case.
#
# This input file defines a canonical ERF test case and should document its main purpose, expected behavior, and key configuration controls.
#
# Expected result:
#   - Case runs successfully and exhibits the documented qualitative behavior.
#
# Configuration:
#   - Core geometry, forcing, and module-specific settings are defined in the file.
#
# Notes:
#   - Add case-specific details here if the scenario is extended in the future.

# ============================================================================
# CORE GEOMETRY AND ATMOSPHERIC SETUP
# ============================================================================

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2000.0 2000.0 500.0
amr.n_cell = 40 40 50

geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 100
amr.max_grid_size_z = 50

zlo.type = "surface_layer"
zhi.type = "SlipWall"

# Surface layer (MOST) parameters
erf.most.z0 = 0.1

# Molecular diffusion and LES
erf.molec_diff_type = "ConstantAlpha"
erf.les_type = "None"

# Initial atmospheric conditions
erf.init_type = "uniform"
erf.theta_ref = 300.0

# Time stepping
erf.fixed_dt = 1.0
stop_time = 900.0
max_step = 1000

# Output control
erf.sum_interval = 50
erf.v = 1
amr.v = 1
erf.check_int = -1
# Atmosphere plotfiles: ERF reads only the _1/_2 keys (erf.plot_int/erf.plot_vars,
# listed here before 2026-09-10, are read by nothing; u and v are not plot names).
erf.plot_int_1 = 100
erf.plot_vars_1 = theta x_velocity y_velocity

# ============================================================================
# FIRE MODULE: MASTER CONTROL FLAGS
# ============================================================================

# Enable/disable fire simulation
erf.fire.enable = true

# Debug output for fire calculations (verbose logging of intermediate values)
erf.fire.fire_debug = false

# Fire grid refinement factor relative to atmospheric grid
# Typical: 5 (fire grid is 5x finer in x,y)
erf.fire.grid_ratio = 5

# ============================================================================
# FUEL MODEL SELECTION
# ============================================================================

# Anderson FBFM13 fuel model ID (1-13)
# Options and representative vegetation:
#   1: Short Grass (grassland, prairie)
#   2: Timber Grass and Understory (forest with grass understory)
#   3: Tall Grass (tall grass, light shrub, cleared areas)
#   4: Chaparral (dense shrub, brush)
#   5: Shrub (moderate density shrub)
#   6: Dormant Brush (dormant shrub, sparse trees)
#   7: Southern Rough (rough pine-hardwood mix)
#   8: Closed Timber Litter (dense forest with litter)
#   9: Hardwood Litter (hardwood forest litter)
#  10: Timber Grass (evergreen forest with grass)
#  11: Light Logging Slash (recently cut forest)
#  12: Medium Logging Slash (moderately decayed logging waste)
#  13: Heavy Logging Slash (dense, heavy logging debris)
erf.fire.fuel_model_id = 8

# ============================================================================
# FUEL MOISTURE: STATIC MOISTURE (DEFAULT, Phase 2)
# ============================================================================
# Set to static values when moisture_dynamic = false
# Units: fraction (0.0 to 1.0, where 0.08 = 8% moisture)

# 1-hour dead fuel moisture content [fraction]
# Typical range: 0.04 (dry) to 0.15 (wet)
erf.fire.moisture_1hr = 0.08

# 10-hour dead fuel moisture content [fraction]
# Typically increases more slowly than 1-hour
erf.fire.moisture_10hr = 0.08

# 100-hour dead fuel moisture content [fraction]
# Changes most slowly; represents deeper fuel bed
erf.fire.moisture_100hr = 0.10

# Live herbaceous and live woody fuel moisture [fraction] (Phase 4)
# The live classes start here
erf.fire.moisture_live = 0.60

# Live classes with moisture_dynamic = true:
#   "legacy" (default) - the dead-fuel time-lag update with the 100-h lag,
#                        bounded to [0.30, 2.50]; its dead-range clamp drops a
#                        value above 0.40 to 0.40 on the first step
#   "fixed"            - held at moisture_live (recommended)
erf.fire.moisture_live_model = "legacy"

# Precipitation rate [mm/hr] (Phase 4, affects moisture dynamics)
# 0.0 = no precipitation
erf.fire.precip_rate_mm_hr = 0.0

# Dead-class update with moisture_dynamic: "timelag" (default, one time constant
# per class) or "stick" (radial diffusion in a cylindrical stick per class, the
# Nelson 2000 framework, lag-calibrated diffusivity; shells checkpointed)
erf.fire.moisture_model = "timelag"
erf.fire.stick.n_shells = 6
erf.fire.stick.radius_cm = 0.15 0.635 2.5    # 1-h, 10-h, 100-h [cm]
erf.fire.stick.rain_surface_moisture = 0.35
erf.fire.stick.diffusivity_scale = 1.0

# Equilibrium moisture curves the dead classes relax toward (both update models):
# "legacy" (default; adsorption/desorption quartics of unknown origin, see
# Source/Fire/ERF_FuelMoisture.H) or "van_wagner" (Van Wagner and Pickett 1985
# drying and wetting EMC, temperature dependent, the pair WRF-SFIRE uses)
erf.fire.emc_model = "legacy"

# ============================================================================
# FUEL MOISTURE: DYNAMIC MOISTURE (Phase 4)
# ============================================================================

# Enable dynamic fuel moisture evolution based on atmospheric humidity/precipitation
# false: use static moisture values above
# true: advance moisture each timestep via ODEs based on RH, T, precipitation
erf.fire.moisture_dynamic = false

# Compute moisture of extinction dynamically from fuel SAV (Phase 4)
# false: use default extinction moisture for fuel model

# ============================================================================
# IGNITION PARAMETERS
# ============================================================================

# Ignition source: center location [m]
erf.fire.ignition_x = 500.0
erf.fire.ignition_y = 1000.0

# Ignition source: circular patch radius [m]
erf.fire.ignition_r = 30.0

# Ignition from a perimeter polygon (CSV of x y vertices; "polygon" closed or
# "polyline" open with half-width polyline_width); empty = disabled
erf.fire.ignition.polygon_file = ""

# Timed point ignitions from a CSV (time x y radius per line); empty = disabled
erf.fire.ignition.schedule_file = ""
erf.fire.ignition.polygon_type = "polygon"
erf.fire.ignition.polyline_width = 10.0
# Stamp the polygon at this time [s] so the atmosphere spins up first; 0 = at
# initialisation (WRF-SFIRE perimeter time)
erf.fire.ignition.polygon_time = 0.0
# Interior state behind the perimeter: arrival time polygon_time - d/R and
# fuel exp(-d/(R tau)) at distance d inside; 0 = whole interior ignites at
# polygon_time with the fuel intact
erf.fire.ignition.polygon_interior_ros = 0.0
erf.fire.ignition.polygon_interior_tau = 0.0
# Temperature-threshold ignition: every burnable, unburned fire cell whose
# k = 0 potential temperature (the field the fuel-moisture update reads)
# exceeds threshold_temp [K] ignites as a disc of threshold_radius [m] (0 =
# one fire cell), from threshold_start_time [s] on; off by default
erf.fire.ignition.threshold_enable = false
erf.fire.ignition.threshold_temp = 573.15
erf.fire.ignition.threshold_radius = 0.0
erf.fire.ignition.threshold_start_time = 0.0

# ============================================================================
# WIND AND TERRAIN ADJUSTMENT FACTORS
# ============================================================================

# Wind measurement reference height [m] (typical MOST: 6.1 m)
# Fire model extracts wind at this height and adjusts to 10 m canopy height
erf.fire.wind_ref_ht = 6.1

# Bypass atmospheric wind interpolation with a constant reference wind, for
# controlled idealized-wind test cases (Exec/RegTests/FireLineIgnition,
# FireAdvectiveWindCoupling). Exact everywhere only with use_waf = false and
# use_terrain_wind = false, since both still apply downstream otherwise.
erf.fire.prescribed_wind   = false
erf.fire.prescribed_wind_x = 0.0
erf.fire.prescribed_wind_y = 0.0

# Sample the wind at this height above ground (above the plume) and bring it
# down to wind_ref_ht with a log profile of roughness wind_sample_z0 (CFBM
# second interpolation option); 0 samples at wind_ref_ht directly
erf.fire.wind_sample_ht = 0.0
erf.fire.wind_sample_z0 = 0.1

# Take the midflame wind height from the per-fuel fcwh table instead of wind_ref_ht
erf.fire.use_per_fuel_wind_ht = false

# Apply Wind Adjustment Factor (WAF) for canopy screening
# true: reduce wind for forest canopy using Andrews formula
# false: use wind as-is
erf.fire.use_waf = true

# WAF formula selection
# Options: "andrews" (default), "behaviorplus"
erf.fire.waf_formula = "andrews"


# Cap the midflame wind at Rothermel's maximum effective wind speed (MEWS):
# 300 ft/min (1.52 m/s) for fine fuels (SAV > 1000 1/ft), 500 ft/min otherwise.
# Rothermel and BEHAVE kernels, including the per-fuel table and the directional path.
# true: cap the wind factor at the MEWS
# false: no cap, as in WRF-Fire (Exec/RegTests/FireLineFire)
erf.fire.use_wind_limit = true

# Apply terrain-based wind corrections (FARSITE model)
# true: modify wind based on slope aspect/elevation
# false: use extracted wind as-is
erf.fire.use_terrain_wind = false

# Terrain file for the fire grid (ERF terrain text format); empty = erf.terrain_file_name
# interpolated to the fire grid. A finer raster here gives the fire the sharp slope.
erf.fire.terrain_file_name = ""

# Terrain wind adjustment factors (used when use_terrain_wind = true)
erf.fire.k_ridge = 1.5      # Ridge speed-up factor (wind accelerates over ridges)
erf.fire.k_shelter = 0.6    # Sheltered wind reduction (wind slows in valleys/ravines)
erf.fire.k_valley = 0.8     # Valley channeling factor (wind alignment in valleys)
erf.fire.k_deflect = 0.3    # Wind deflection factor (affects wind direction change)

# Horizontal interpolation of the atmospheric wind onto the finer fire grid
# "bilinear" (default) blends the four atmospheric columns surrounding each fire
#            cell, every one sampled at the reference height above its own ground
# "nearest"  takes only the column containing the cell, so every fire cell in a
#            column shares one wind vector
erf.fire.wind_interp = "bilinear"

# Evaluate the rate of spread along the local front normal on the level-set
# path, instead of applying one scalar rate in every direction. The wind and
# slope are projected onto the normal and the selected model is evaluated with
# the projected scalars, so head, flank and backing spread come from the model.
# false (default) keeps the isotropic behaviour. No effect on the FARSITE path,
# which gets its directionality from the Anderson ellipse.
erf.fire.directional_ros = false

# Form of the directional rate (needs directional_ros; not for balbi or hybrid).
# "projection" (default) evaluates the model with the wind and slope projected
#              onto the front normal; from a point ignition its head runs below
#              the model's head rate once the wind or slope factor is large
# "ellipse"    uses the support function of the ellipse with the model's head
#              rate (wind and slope increments added as vectors) and its
#              no-wind, no-slope rate at the back and flanks, so a point fire's
#              head runs at the head rate
erf.fire.directional_shape = "projection"

# With directional_shape = "projection" and ros_model = "rothermel": couple
# the wind/slope factor to the front-normal direction either the way
# Rothermel's own formula does (projecting the wind first, then
# exponentiating -- non-convex once phi_w(B-1) > 1, so a point or finite-line
# fire's head falls toward the Wulff-shape tip rate) or by exponentiating the
# raw wind, then scaling by the cosine to the front normal (matching
# WRF-Fire's fire_ros) -- convex, so the head runs at the head rate, like the
# "ellipse" shape but without imposing an ellipse.
# "projection" (default)
# "advective"
erf.fire.directional_wind_coupling = "projection"

# Flank rate of the "ellipse" shape (needs directional_shape = "ellipse").
# "model" (default) keeps the model's no-wind, no-slope rate at the flanks, so
#          the length-to-width ratio (R_h/R0 + 1)/2 is not capped
# "anderson" sets the flank rate to b / LW with Anderson's (1983) ratio LW at the
#          effective wind speed (the wind that alone gives the head rate, so a
#          slope elongates the fire too), capped at directional_ellipse_lw_max;
#          head and back rates are unchanged
erf.fire.directional_ellipse_lw = "model"
erf.fire.directional_ellipse_lw_max = 8.0

# Front propagation path: "farsite" (Huygens ellipse, default) or "levelset"
erf.fire.propagation_method = "farsite"

# Level-set numerics: subcycle CFL, artificial viscosity away from the front
# (eps_visc_front below applies near it), and the Sussman reinitialisation
# (every N subcycles, iterations, band half-width in m and pseudo-dt; <0 = auto)
erf.fire.levelset.cfl = 0.4
erf.fire.levelset.eps_visc = 0.4
erf.fire.levelset.reinit_every = 5
erf.fire.levelset.reinit_iters = 10
erf.fire.levelset.reinit_band_m = -1.0
erf.fire.levelset.reinit_dtau = -1.0

# Level-set path only: extrapolate the level set into non-burnable cells
# inside every stencil (gradient, Laplacian, front normal, reinitialisation),
# so a masked wall is a zero-gradient boundary of the distance function.
# Without it the cells along a wall burn down at the rate the one-sided
# difference into the wall dictates and the flank along the wall runs about
# 20% fast. No effect without a mask source (see NON-BURNABLE MASK).
erf.fire.levelset.wall_extrapolate = false
# Spread as a Huygens ellipse set by the midflame wind (FARSITE family) instead
# of a disc; exclusive with directional_ros. ellipse_lw fixes the
# length-to-width ratio (0 = Anderson 1983 from the wind), ellipse_lw_max caps it
erf.fire.levelset.ellipse = false
erf.fire.levelset.ellipse_lw = 0.0
erf.fire.levelset.ellipse_lw_max = 8.0
erf.fire.levelset.gradient = weno5z_front       # "upwind" (first order everywhere), "weno5z" (HJ-WENO5-Z everywhere), "weno5z_front" (WENO in the front band; WRF-Fire hybrid)
erf.fire.levelset.weno_band_cells = 4           # half-width of that front band in fire cells
erf.fire.levelset.eps_visc_front = 0.1          # near-front artificial viscosity (WRF-Fire fire_viscosity_bg, 0.1 as in CFBM); < 0 keeps eps_visc everywhere
erf.fire.levelset.visc_front_cells = 2          # half-width of the near-front viscosity band in fire cells (fire_viscosity_ngp)
erf.fire.levelset.visc_transition_cells = 2.0   # width of the linear blend from eps_visc_front to eps_visc, in fire cells

# ============================================================================
# RATE-OF-SPREAD MODEL SELECTION
# ============================================================================

# Which rate-of-spread model fills fire_ros
# "rothermel"    (default) Rothermel (1972) single-class empirical model
# "behave"       BEHAVE multi-class Rothermel
# "macarthur"    MacArthur (1966) Australian formula
# "cheney_gould" Cheney & Gould (1998) grassland model
# "fbp"          Canadian Forest Fire Behavior Prediction System (erf.fire.fbp.*)
# "balbi"        Balbi physical model (see the Balbi section below)
# "hybrid"       two of the above blended per cell (see the HYBRID section)
# "prescribed"   a rate set in the deck, for verification (see PRESCRIBED below)
erf.fire.ros_model = "rothermel"

# Evaluate Rothermel coefficients per cell from the spatial fuel map instead
# of the domain fuel_model_id. No effect without erf.fire.fuel_map.file.
erf.fire.rothermel_per_fuel = false

# Rothermel/BEHAVE reaction-velocity exponent A (needs ros_model = "rothermel"):
# "albini"    (default) Albini's (1976, GTR-INT-30) reformulation, ERF's own
#             form, A = 133*sigma^-0.7913
# "rothermel" Rothermel's (1972) original form, A = 1/(4.774*sigma^0.1-7.27),
#             as used by WRF-Fire; has a pole near sigma = 67 ft^-1, safely
#             below ERF's minimum-SAV guard (sigma clamped to >= 100)
erf.fire.reaction_velocity_formula = "albini"

# ============================================================================
# PRESCRIBED RATE OF SPREAD (used only when ros_model = "prescribed")
# ============================================================================
# R(x,y) = max(min_ros, R_base + dR/dx (x - x0) + dR/dy (y - y0)), with R_base
# the rate listed for the cell's fuel code in by_fuel (pairs of code and rate,
# needs fuel_map.file), else prescribed.ros. No wind, slope or moisture
# dependence and no direction: directional_ros is turned off, and the level set
# solves |grad T| = 1/R as posed. For the closed-form verification cases in
# Exec/CanonicalTests/Fire/Verification.
erf.fire.prescribed.ros = 0.0
erf.fire.prescribed.gradient = 0.0 0.0
erf.fire.prescribed.origin = 0.0 0.0
erf.fire.prescribed.min_ros = 0.0
# erf.fire.prescribed.by_fuel = 1 1.0 2 0.5

# ============================================================================
# HYBRID ROS (used only when ros_model = "hybrid")
# R = (1 - w) R_primary + w R_secondary with a per-cell weight w in [0,1].
# Works on the isotropic path and, with directional_ros, on the
# direction-dependent level-set path.
# ============================================================================

erf.fire.hybrid.primary   = "rothermel"   # model where w = 0
erf.fire.hybrid.secondary = "balbi"       # model where w = 1 (uses erf.fire.balbi.*)

# How w is set
# "region"    w = 1 inside hybrid.region, 0 outside (static)
# "fuel"      w = 1 on cells whose fuel code is in hybrid.secondary_fuel_codes (static)
# "structure" w = 1 within hybrid.structure_distance of a structure cell (static)
# "wind"      w ramps 0 -> 1 between hybrid.wind_lo and wind_hi (rebuilt every step)
erf.fire.hybrid.selector = "region"

erf.fire.hybrid.region = 0.0 0.0 0.0 0.0       # x_lo y_lo x_hi y_hi [m]; required for "region"
erf.fire.hybrid.blend_width = 0.0             # linear ramp width across the region or structure edge [m]; 0 = step
# erf.fire.hybrid.secondary_fuel_codes = 3    # required for "fuel"
# erf.fire.hybrid.structure_file = ""         # ERF terrain-format building heightmap; default erf.buildings_file_name
erf.fire.hybrid.structure_min_height = 0.5    # sampled height [m] above which a cell is a structure
erf.fire.hybrid.structure_distance = 10.0     # cells within this distance of a structure take the secondary [m]
erf.fire.hybrid.wind_lo = 8.0                 # effective wind speed [m/s] where w reaches 0
erf.fire.hybrid.wind_hi = 12.0                # effective wind speed [m/s] where w reaches 1

# Arrival-time probes: flat list of x y pairs [m]. Each prints one
# "[FIRE PROBE]" line on the step its fire cell first burns. Any ROS model.
# erf.fire.probes = 100.0 50.0 200.0 50.0

# Per-structure exposure diagnostics (needs erf.fire.structures.enable).
# Each connected footprint of the heightmap gets an id; every `interval`
# fire steps one line per structure goes to `file` with the first and last
# arrival of the front in the band of burnable cells within `ring` fire
# cells of the footprint, the fraction of that band burned, the peak
# fireline intensity and the accumulated heat load there, and the embers
# that landed on the footprint. Adds fire_structure_id, fire_heat_load,
# fire_peak_intensity and fire_ember_landings to the fire plotfile.
erf.fire.exposure.enable = false
erf.fire.exposure.file = "fire_exposure.csv"
erf.fire.exposure.interval = 100
erf.fire.exposure.ring = 1

# ============================================================================
# NON-BURNABLE MASK: STRUCTURES, FUEL CODES, FIREBREAKS
# Cells in the mask get zero rate of spread, the level set is held outside
# the burned region, FARSITE and spotting landings are rejected, and fuel
# and heat are zero. Every source is off by default.
# ============================================================================

# Structures from a building heightmap in the ERF terrain text format,
# sampled onto fire cell centres by nearest point (the same file and sampling
# the hybrid "structure" selector uses; that selector alone does not stop the
# fire). The file defaults to erf.fire.hybrid.structure_file, then
# erf.buildings_file_name.
erf.fire.structures.enable = false
# erf.fire.structures.file = ""
erf.fire.structures.min_height = 0.5      # sampled height [m] above which a cell is a structure
# Renormalise the bilinear wind weights over the atmospheric columns that are
# open at the fire cell's wind height (a column whose sampled roof is above
# that height counts with its open fraction), so the relaxed velocity inside
# an immersed-forcing building does not leak into the wind of the fire cells
# around it. Needs structures.enable; no effect with wind_interp = "nearest".
erf.fire.structures.wind_open_columns = false

# Spatial fuel map on the fire grid: ESRI ASCII ("ascii") or FARSITE landscape
# ("lcp") file; empty = the uniform fuel_model_id. blending_fraction blends the
# ROS across fuel boundaries (0 = none, 1 = full neighbour average).
erf.fire.fuel_map.file = ""
erf.fire.fuel_map.format = "ascii"
erf.fire.fuel_map.blending_fraction = 0.0

# Fuel codes that are non-burnable. Empty by default, in which case an
# unknown code (including 0, the nodata value) still falls through to fuel
# model 1 in the Rothermel table. Recommended with a fuel map:
# erf.fire.fuel_map.nonburnable_codes = 0 91 92 93 98 99

# Fuel model set: "anderson13" (default, codes 1-13) or "scott_burgan40" (the
# Scott and Burgan 40 alongside them, LANDFIRE FBFM40 codes 101-204; 0 and
# 91-99 non-burnable without listing them). sb40_crosswalk translates the 40 to
# the 13 at load (the CFBM route). load_from_map starts each cell with its own
# model's fuel load instead of the uniform one.
erf.fire.fuel_map.fuel_set = "anderson13"
erf.fire.fuel_map.sb40_crosswalk = false
erf.fire.fuel_map.load_from_map = false

# Hold the firebreak cells in the mask as well (they are otherwise only
# stamped into phi once, which the level-set reinitialisation can erode)
erf.fire.firebreak.use_mask = false

# ============================================================================
# BALBI PHYSICAL MODEL (used only when ros_model = "balbi")
# ============================================================================

# Formulation
# "2009" (default) steady explicit form, R = A (1 + sin a - cos a).
#        No no-wind base spread and the wind response saturates at 2A.
# "2020" convective-radiative form, R = Rb + Rc + Rr solved per cell.
#        Nonzero no-wind spread and an unsaturated wind response.
erf.fire.balbi.formulation = "2009"

# Thermal parameters shared by both formulations
erf.fire.balbi.T_a = 300.0        # Ambient temperature [K]
erf.fire.balbi.T_f = 1000.0       # Mean flame temperature [K] (2009 only)
erf.fire.balbi.T_i = 600.0        # Ignition temperature [K]
erf.fire.balbi.delta_H = 2.26e6   # Latent heat of vaporisation [J/kg]
erf.fire.balbi.C_pf = 1800.0      # Specific heat of dry fuel [J/(kg K)]
erf.fire.balbi.tau_0 = 75591.0    # Flame residence time coefficient [s/m]

# Model coefficient r00. The default moves with the formulation:
# 2.5e-4 m under "2009" (radiation length scale) and 2.5e-5 under "2020"
# (the value fitted by Balbi et al. 2020). Setting it here overrides both.
# erf.fire.balbi.r_00 = 2.5e-4

# Balbi (2020) constants (ignored under the 2009 formulation)
erf.fire.balbi.chi_0 = 0.3        # Radiant fraction [-]
erf.fire.balbi.C_pa = 1150.0      # Specific heat of air [J/(kg K)]
erf.fire.balbi.C_pw = 4180.0      # Specific heat of water [J/(kg K)]
erf.fire.balbi.T_vap = 373.0      # Water vaporisation temperature [K]
erf.fire.balbi.K1 = 130.0         # Drag coefficient [s/m]
erf.fire.balbi.st = 17.0          # Air to pyrolysis-gas mass ratio [-]
erf.fire.balbi.rho_a = 1.2        # Air density [kg/m3]
erf.fire.balbi.sigma_B = 5.6e-8   # Stefan-Boltzmann constant [W/(m2 K4)]

# Balbi (2020) root solve: R = Rb + Rc + Rr is solved by bisection
erf.fire.balbi.max_iter = 40      # Iteration cap
erf.fire.balbi.tol = 1.0e-4       # Bracket width [m/s]

# Direction-dependent spread on the level-set path
# true: evaluate the ROS along the front normal, so head, flank and backing
#       spread come from the model instead of an imposed ellipse
# false: (default) use the wind and slope magnitudes, giving an isotropic
#       head-fire ROS
# No effect on the FARSITE path, which gets its directionality from the
# ellipse. Costs roughly 3x the fire-side work, since the ROS field is
# rebuilt in every Runge-Kutta stage.
erf.fire.balbi.directional = false

# Take the ambient temperature per cell from fire_surface_temp instead of
# the fixed balbi.T_a above
erf.fire.balbi.use_surface_temp = false

# Derive the 2009 mean flame temperature from the combustion energy instead
# of the fixed balbi.T_f. The 2020 form always computes its own.
erf.fire.balbi.flame_temp_from_combustion = false

# Take the fuel moisture per cell from the Phase 4 moisture ODE state
# instead of the domain average. Requires moisture_dynamic = true.
erf.fire.balbi.use_cell_moisture = false

# Zero the ROS at and above the fuel model's moisture of extinction.
# Neither Balbi formulation carries an extinction limit of its own, so
# without this a fuel bed wetter than its M_x still spreads.
erf.fire.balbi.use_moisture_extinction = false

# Fraction of the live herbaceous load carried as cured dead fine fuel
# [0-1]. Only the 2020 form uses a fuel load, so this does nothing under
# the 2009 formulation.
erf.fire.balbi.herb_curing = 0.0

# Which wind the model consumes
# "midflame"  (default) the wind after the Wind Adjustment Factor and terrain
#             corrections, as every other ROS model uses
# "reference" the reference-height wind before those corrections. Balbi
#             normalises the wind by its own vertical velocity scale rather
#             than by a midflame reduction, so the WAF is arguably double
#             counting.
erf.fire.balbi.wind_source = "midflame"

# Augment the vertical velocity scale with the fire-induced component built
# from the surface heat flux, combined in quadrature. A stronger plume stands
# the flame more upright and slows the head fire. The heat flux is filled at
# the end of the fire step, so this feedback lags the ROS by one step.
erf.fire.balbi.heat_flux_coupling = false
erf.fire.balbi.k_upward = 1.0        # Scale on the induced velocity [-]
erf.fire.balbi.hf_ref_height = 10.0  # Reference height for the induced velocity [m]

# ============================================================================
# CHENEY-GOULD GRASSLAND MODEL (used only when ros_model = "cheney_gould")
# ============================================================================

erf.fire.cheney_gould.moisture = 10.0  # Dead fine fuel moisture [%]
erf.fire.cheney_gould.curing = 1.0     # Degree of curing [0-1], 1 = fully cured

# ============================================================================
# CANADIAN FBP SYSTEM (used only when ros_model = "fbp")
# ============================================================================
# Fuel type C1-C7, D1, M1-M4, S1-S3, O1A, O1B; daily indices uniform over the
# domain; the wind is the reference-height wind (set wind_ref_ht = 10) or the
# midflame wind; slope through the system's equivalent wind
erf.fire.fbp.fuel_type = "C2"
erf.fire.fbp.ffmc = 90.0
erf.fire.fbp.bui = 60.0
erf.fire.fbp.curing = 60.0       # grass types [%]
erf.fire.fbp.pc = 50.0           # percent conifer (M1, M2)
erf.fire.fbp.pdf = 50.0          # percent dead fir (M3, M4)
erf.fire.fbp.use_slope = true
erf.fire.fbp.wind_source = "reference"

# ============================================================================
# BEHAVE MULTI-CLASS ROTHERMEL (used only when ros_model = "behave")
# ============================================================================
# Live herbaceous moisture window of the live-to-dead herbaceous transfer: the
# whole live herbaceous load joins the dead class at and below lo, none at and
# above hi, the share (hi - M)/(hi - lo) between; hi must exceed lo. Only fuels
# with a live herbaceous load respond (Anderson model 1 has none).
erf.fire.behave.dynamic_transfer_lo = 0.30   # [fraction]
erf.fire.behave.dynamic_transfer_hi = 1.20   # [fraction]

# ============================================================================
# FIRE PROPAGATION: ROTHERMEL MODEL (Phases 1-3)
# ============================================================================

# Residence time [s] for fuel burnout
# 0.0: derive from fuel SAV (recommended)
# >0: use this fixed value
erf.fire.tau_residence_s = 0.0

# Burnout of the fuel behind the front: "residence" (default) is the cell
# crossing time floored by the particle burnout time (or tau_residence_s);
# "sfire" is WRF-SFIRE's burn time per fuel model (7 s grass ... 900 s timber
# litter and slash, CFBM Table 1) divided by burnout_time_to_efold, so heavy
# fuels keep burning behind the front. burnout_times_s (13 values) overrides
# the table.
erf.fire.burnout_model = "residence"
erf.fire.burnout_time_to_efold = 0.8514
#erf.fire.burnout_times_s = 7 7 7 180 100 100 100 900 900 900 900 900 900

# Combustion fraction bounds for heat flux calculation
# Fraction of fuel consumed: typically 0.2 (minimum) to 0.9 (maximum)

# ============================================================================
# LEVEL-SET ADVECTION (FARSITE Model, Phase 3)
# ============================================================================

# Front update of the FARSITE path
# "front_cell" (default): unburned cells next to the burned region burn when
#   the spread shape grown from their burned neighbours' arrival times reaches
#   them, one row at a time
# "legacy": the update before 2026-09, marker stamping from every cell at or
#   below phi_threshold; the front ran about twice the rate of spread
erf.fire.farsite.front_update = "front_cell"

# Fire front detection threshold for phi level-set (legacy update only)
# Unburned: phi > farsite_phi_threshold
# Burned: phi < -threshold
# Front: near-zero phi
erf.fire.farsite.phi_threshold = 0.1

# Use Anderson fuel L/W ratio to set FARSITE head/flank/backing ellipse coefficients
# true: derive coeff_a/b/c from fuel model (default)
# false: use explicit values below
erf.fire.farsite.use_anderson_lw = 1

# Explicit ellipse coefficients (used only when use_anderson_lw = 0)
# Approximate fire spread ellipse shape
# Higher a → more head-fire dominance
erf.fire.farsite.coeff_a = 0.5   # Head fire coefficient (0 to 1)
erf.fire.farsite.coeff_b = 0.25  # Flank fire coefficient
erf.fire.farsite.coeff_c = 0.1   # Backing fire coefficient

# Gaussian stamping radius for fire front [m] (legacy update only)
# < 0: auto-compute from grid resolution
# > 0: manual override (use for tuning)
erf.fire.farsite.gaussian_sigma = -1.0

# CFL number for fire advection (stability)
# Typical: 0.3 to 0.6; smaller = more stable but slower
erf.fire.farsite.cfl_fire = 0.5

# ============================================================================
# HEAT FLUX AND DIAGNOSTICS (Phase 5)
# ============================================================================

# Write CSV file with burned area, perimeter, and fire statistics
erf.fire.write_fire_stats_csv = true

# CSV output filename for fire statistics
erf.fire.fire_stats_csv_file = "fire_stats.csv"

# ============================================================================
# FIRE-ATMOSPHERE COUPLING (Phase 6)
# ============================================================================

# Coupling mode between fire and atmospheric heat/moisture injection
# Options:
#   "passive"    — fire heat computed but NOT injected into atmosphere
#   "lagged"     — lagged coupling (default): heat from step n → atmosphere at step n+1
#   "synchronous"— synchronous: fire uses post-dycore wind (step n), heat still enters at n+1
erf.fire.coupling_type = "lagged"

# E-folding height for vertical distribution of sensible heat [m]
# Heat decays exponentially with height; controls heating depth
erf.fire.heat_flux_alfg = 45.0

# Multiplier on fire heat flux (for sensitivity studies)
# 0.0 = one-way atmosphere→fire (no feedback)
# 1.0 = full two-way coupling
erf.fire.fire_atm_feedback = 1.0

# Inject latent heat alongside sensible heat (WRF-Fire parity)
# true: add moisture to domain (realistic evaporation)
# false: sensible heat only
erf.fire.inject_latent = true

# Split of the heat release between the sensible and latent flux handed to
# the atmosphere
# "legacy" (default): sensible flux is the full heat release of the dry fuel
# "cfbm": sensible flux scaled by the dry-fuel fraction 1/(1+M_f), Eq. 4 of
#         Jimenez y Munoz et al. (2026); latent flux unchanged
erf.fire.heat_flux_partition = "legacy"

# Prescribed surface heat flux [W/m2] added to the fire heat flux over a disc,
# whatever the fuel and the front, and injected like fire heat; 0 = off. For
# plume verification (Exec/CanonicalTests/Fire/Verification/Calm_Plume).
# end_time < 0 keeps it on for the whole run.
erf.fire.prescribed_heat.flux = 0.0
erf.fire.prescribed_heat.center = 0.0 0.0
erf.fire.prescribed_heat.radius = 0.0
erf.fire.prescribed_heat.start_time = 0.0
erf.fire.prescribed_heat.end_time = -1.0

# Passive smoke tracer: a fraction of the fuel burnt released into the first
# atmospheric layer (Coen 2013, the Community Fire Behavior Model default)
erf.fire.smoke_enable = false
# kg of smoke per kg of fuel burnt
erf.fire.smoke_emission_factor = 0.02
# Heat per kg of fuel that converts the lagged flux back into fuel burnt [J/kg]
erf.fire.smoke_heat_of_comb = 1.87e7
# true: use the fuel model's own heat content instead of smoke_heat_of_comb
erf.fire.smoke_heat_from_fuel = false

# How the fire tendency enters the cell source once make_sources has rebuilt
# it for the Runge-Kutta stage
# "overwrite" (default, legacy) replaces the theta and vapour slots, which
#             discards any other source in them (immersed-forcing scalar
#             relaxation, radiation heating, Rayleigh damping)
# "add"       accumulates into the freshly rebuilt source, once per stage;
#             required to run fire heat together with immersed-forcing buildings
erf.fire.source_mode = "overwrite"

# Place the injected heat only in the open part of each atmospheric column:
# below the sampled roof height a cell's share is scaled by the column's open
# fraction (one minus the area covered by structure cells) and the column is
# renormalised, so no fire heat lands inside a building and the energy per
# column is unchanged. Needs erf.fire.structures.enable.
erf.fire.heat_open_fraction = false

# Tendency form. false (default): the energy-consistent -(1/Cp) dQ/dz, with
# which the coupling's energy diagnostic reads 1 - exp(-z_top/alfg). true: the
# historical -rho (1/Cp) dQ/dz, which injects rho times the fire flux, about
# 10-15% too much at sea level; kept to reproduce older coupled results.
erf.fire.heat_tendency_density = false

# ============================================================================
# TERRAIN FILE (Optional)
# ============================================================================
# Path to fine-grid terrain data for interpolation onto fire grid
# Leave empty for no fine-grid terrain
erf.terrain_file_name = ""

# ============================================================================
# PHASE 8: ALBINI SPOTTING DIAGNOSTICS (Ember spotting)
# ============================================================================

# Enable ember spotting (lofting of firebrands above the fire)
erf.fire.spotting.enable = false

# Minimum Byram intensity to launch firebrands [kW/m]
# Firebrands only generated from cells with I_B >= this value
erf.fire.spotting.I_B_min = 100.0

# Base launch probability per front cell per timestep [0-1]
# Typical: 0.01 to 0.1 (probability each fire-front cell emits a firebrand per step)
erf.fire.spotting.P_base = 0.05

# Firebrand terminal fall velocity [m/s]
# Typical: 0.2 to 1.0 m/s (higher = less horizontal transport)
erf.fire.spotting.terminal_velocity = 0.5

# Trajectory integration sub-steps per atmospheric timestep
# Higher = more accurate landing position, more computationally expensive
# Typical: 10 to 50
erf.fire.spotting.n_traj_steps = 20

# Ignition disk radius at landing [m]
# Area where a landed firebrand can ignite new fire
erf.fire.spotting.spot_radius = 15.0
# Which burned cells may launch a brand. "burned" (default): every cell behind
# the front, so the brand count scales with the burned area. "front": only
# burned cells with unburned fuel within front_band fire cells, the fireline
# Albini's model assumes, so the count scales with its length.
erf.fire.spotting.launch_from = "burned"
erf.fire.spotting.front_band = 2

# Catching probability at landing [0-1]
# Probability that landing spot successfully ignites
erf.fire.spotting.P_catch = 1.0

# Minimum residual fuel fraction for re-entry [0-1]
# Firebrands can only ignite if fuel consumption < (1 - reentry_threshold)
erf.fire.spotting.reentry_fuel_thresh = 0.05

# Random seed for firebrand trajectory stochasticity
# 0 = time-based seed (non-reproducible)
# >0 = fixed seed (reproducible)
erf.fire.spotting.random_seed = 42

# Apply spotting every N fire subcycles (to reduce computational cost)
erf.fire.spotting.spotting_interval = 5

# Fuel system for spotting analysis
# Options: "13" (Anderson FBFM13), "40" (Scott-Burgan 40-class)
erf.fire.spotting.fuel_system = "13"

# ============================================================================
# PHASE 9: CROWN FIRE INITIATION (Van Wagner + Cruz models)
# ============================================================================

# Enable crown fire initiation and active crown fire spread
erf.fire.crown.enable = false

# Canopy base height (height to bottom of live canopy) [m]
# Lower values = more exposed canopy to fire heat
# Typical: 3-10 m (conifers), 5-15 m (hardwoods)
erf.fire.crown.canopy_base_ht = 5.0

# Canopy bulk density (total canopy fuel mass per volume) [kg/m³]
# Higher values = denser, more flammable canopy
# Typical: 0.05-0.30 kg/m³ (sparse to dense conifer)
erf.fire.crown.canopy_bulk_den = 0.2

# Canopy depth (vertical extent of canopy) [m]
# Height from base to top of canopy
# Typical: 10-30 m
erf.fire.crown.canopy_depth = 10.0

# Foliar moisture content (canopy water content) [fraction 0-1]
# 1.0 = 100% moisture (saturated, hard to burn)
# 0.5 = 50% moisture (typical moist condition)
erf.fire.crown.foliar_moisture = 1.0

# Critical foliar moisture (Van Wagner 1977 threshold) [fraction]
# Below this, crown fire impossible due to moisture

# Canopy heat content (energy released when canopy burns) [BTU/lb]
# Typical: 8000 BTU/lb (slightly lower than surface fuels due to moisture)
erf.fire.crown.h_crown_BTU_lb = 8000.0

# 10-m wind speed for crown ROS calculations [km/h]
# 0.0 = auto-derive from fire_wind_eff
# >0 = use this fixed value (for testing/sensitivity)
erf.fire.crown.wind_10m_kmh = 0.0

# Crown fire ROS model selection
# Options:
#   "cruz"           — Cruz et al. (2005) empirical wind/CBD/moisture regression
#   "rothermel1991"  — Rothermel (1991): R_crown = 3.34 × R_surface
#   "van_wagner_proxy"— Van Wagner (1977) proxy: R = (3/CBD) × moisture_factor
erf.fire.crown.ros_model = "cruz"

# Use Van Wagner passive-to-active crown ROS blending
# false: hard override (R_crown replaces R_surface when active)
# true: smooth transition via crowning fraction CF = (I_B/I_o)^(2/3)
erf.fire.crown.use_passive_blend = false

# ============================================================================
# PHASE 9: FLAME TEMPERATURE DIAGNOSTICS
# ============================================================================

# Flame temperature estimation method
# Options:
#   "byram_radiant"     — Byram (1959): T = T_amb + 800 × (I_B/1000)^0.25
#   "mcalpine_heat"     — McAlpine & Xanthopoulos (1989): adiabatic flame temp
#   "nelson_emissivity" — Nelson (1980): Stefan-Boltzmann law with emissivity
erf.fire.flame_temp_method = "byram_radiant"

# Ambient temperature for flame temperature formula [K]
# Used in Byram and McAlpine formulas
erf.fire.flame_temp_T_amb = 300.0

# ============================================================================
# PHASE 9: FLAME TILT ANGLE DIAGNOSTICS
# ============================================================================

# Compute flame tilt angle (diagnostic, no impact on fire spread)
# false: do not compute (saves memory/computation)
# true: compute tilt angle [degrees from vertical]
erf.fire.compute_flame_tilt = false

# Ambient temperature for flame tilt formula [K]
# Used in buoyancy velocity calculation
erf.fire.flame_tilt_T_amb = 300.0

# Air density for flame tilt formula [kg/m³]
# Standard sea level: 1.225 kg/m³
# Adjust for altitude or temperature as needed
erf.fire.flame_tilt_rho_air = 1.2

# ============================================================================
# PHASE 12: STARTUP FIRE ACCELERATION
# ============================================================================
# Theory: Docs/sphinx_doc/theory/fire_acceleration.rst

# Scale the rate of spread of a young fire (default false: no acceleration)
erf.fire.accel.enable = false

# false: size-based model, alpha = 1 - exp(-r_fire / L_acc) on every cell
# true: temporal model, R = R_E (1 - exp(-A t))
erf.fire.accel.use_temporal = false

# Size-based acceleration length scale [m]
erf.fire.accel.L_acc = 50.0

# Temporal acceleration constants [1/min]: point fire while the burned
# perimeter is at most perim_limit [m], line fire beyond it
erf.fire.accel.A_point = 0.115
erf.fire.accel.A_line = 0.886
erf.fire.accel.perim_limit = 500.0

# Clock of the temporal model
#   "legacy": a clock per burned cell, started when the cell burns and restarted
#             on any change of its equilibrium rate, written to burned cells
#             only, so it barely acts on the front (before 2026-09)
#   "front":  the time since ignition, carried with the front into the cells it
#             burns and applied to the rate that moves it on every path; a
#             separate ignition (spot, schedule, threshold) starts its own clock
erf.fire.accel.clock = "legacy"

# Exponential lag on increases of the equilibrium rate (legacy clock only;
# aborts with clock = "front") and its time constant [s]
erf.fire.accel.enable_wind_lag = false
erf.fire.accel.tau_wind = 60.0

